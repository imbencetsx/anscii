#!/bin/sh
# Run the optimized native binary from any working directory.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -x "$project_dir/target/release/anscii" ]; then
    echo 'Build first: cargo build --release --locked' >&2
    exit 1
fi
exec "$project_dir/target/release/anscii" "$@"
